# Storefront (Next 16) — copy to `.env.local` and adjust.
# Nothing here is a secret except REVALIDATE_SECRET, and that one is a
# placeholder: rotate it before any shared deployment.

# auth-svc (NestJS, :4010). Read by the BFF handlers in app/api/auth/* and by
# proxy.ts, which rewrites GET /api/auth/session to `${AUTH_SVC_URL}/api/v1/auth/me`.
AUTH_SVC_URL=http://localhost:4010

# cms-svc (NestJS, :4050). Read by the CMS client (lib/cms/client.ts).
CMS_BASE_URL=http://localhost:4050

# catalog-svc (NestJS, :4020). Read by lib/catalog/client.ts through the
# service registry (lib/services/urls.ts) — server components only.
CATALOG_SVC_URL=http://localhost:4020

# cart-svc (NestJS, :4030). Read by lib/cart/client.ts + the /api/cart BFF.
CART_SVC_URL=http://localhost:4030

# order-svc (NestJS, :4040). Read by lib/order/client.ts + the /api/checkout
# and /api/orders BFF routes. Timeout is 8 s (payment provider in the path).
ORDER_SVC_URL=http://localhost:4040

# analytics-svc (NestJS, :4060). Read by the /api/track BFF route; the browser
# only ever calls this origin, never the service directly.
ANALYTICS_SVC_URL=http://localhost:4060

# search-svc (NestJS, :4090). Read by /api/search/suggest and /api/search/trending.
SEARCH_SVC_URL=http://localhost:4090

# Secret sent as x-service-key to search-svc's internal/trending endpoint.
# Server-only: it must never be imported by a client island.
INTERNAL_SERVICE_KEY=dev-internal-service-key

# Public origin for absolute URLs (canonical, OG, sitemap, JSON-LD). Not a
# secret; set this to the real host when deploying.
SITE_URL=http://localhost:3000

# Shared secret for POST /api/revalidate (cms-007 will call it after commit).
# Sent as `x-revalidate-secret`; compared in constant time.
REVALIDATE_SECRET=dev-revalidate-secret-change-in-prod
