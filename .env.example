# Storefront (Next 16) — copy to `.env.local` and adjust.
# Nothing here is a secret except REVALIDATE_SECRET, and that one is a
# placeholder: rotate it before any shared deployment.

# auth-svc (NestJS, :4010). Read by the BFF handlers in app/api/auth/* and by
# proxy.ts, which rewrites GET /api/auth/session to `${AUTH_SVC_URL}/api/v1/auth/me`.
AUTH_SVC_URL=http://localhost:4010

# cms-svc (NestJS, :4050). Read by the CMS client (lib/cms/client.ts).
CMS_BASE_URL=http://localhost:4050

# Shared secret for POST /api/revalidate (cms-007 will call it after commit).
# Sent as `x-revalidate-secret`; compared in constant time.
REVALIDATE_SECRET=dev-revalidate-secret-change-in-prod
